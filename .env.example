# Desenvolvimento local usa data/app.db se DATABASE_URL não for informado.
# Produção (Vercel + Turso/libSQL)
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# Criado automaticamente ao conectar um Blob privado ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN=
STORAGE_DRIVER=blob

# Segredo longo exigido para criar o primeiro administrador em produção (Vercel ou qualquer
# build de produção público). Na rede local (instalador) não é preciso.
SETUP_SECRET=

# Rede local sem HTTPS (`next start` no PC da loja): cookie de sessão sem "secure" e primeiro
# acesso sem chave. O instalador do Windows já define isso; só use à mão se rodar `npm start`.
# LOCAL_NETWORK_HTTP=1

# Força o cookie seguro ("true") ou inseguro ("false"), independente do ambiente.
# SESSION_COOKIE_SECURE=
