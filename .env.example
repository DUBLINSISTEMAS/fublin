# Desenvolvimento local usa data/app.db se DATABASE_URL não for informado.
# Produção (Vercel + Turso/libSQL)
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# Criado automaticamente ao conectar um Blob privado ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN=
STORAGE_DRIVER=blob

# Segredo longo exigido somente para criar o primeiro administrador em produção.
SETUP_SECRET=

# Opcional: habilite apenas na etapa controlada que aplica migrações.
AUTO_MIGRATE_DB=false
